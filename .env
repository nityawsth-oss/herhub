# ═════════════════════════════════════════════════════════════════════════
# HERHUB SUPABASE CLOUD DATABASE CONFIGURATION
# National Level Hackathon Edition
# ═════════════════════════════════════════════════════════════════════════
# If you have created a Supabase project at https://supabase.com:
# 1. Go to Project Settings -> API
# 2. Copy "Project URL" and paste below in REACT_APP_SUPABASE_URL
# 3. Copy "anon public" API key and paste below in REACT_APP_SUPABASE_ANON_KEY

REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# HuggingFace AI/ML Model Token (get free token at https://huggingface.co/settings/tokens)
REACT_APP_HF_TOKEN=your-huggingface-token-here
